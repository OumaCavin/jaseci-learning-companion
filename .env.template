# This directory should contain environment variables for development
# Copy from .env.template and fill in your values

# Database Configuration
DATABASE_URL=postgresql://jaseci_user:jaseci_password@localhost:5432/jaseci_learning
REDIS_URL=redis://:jaseci_redis_password@localhost:6379/0
NEO4J_URI=bolt://neo4j:7687
ELASTICSEARCH_URL=http://localhost:9200
NATS_URL=nats://localhost:4222

# Application Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
API_SECRET_KEY=<SECRET_KEY_PLACEHOLDER>
JWT_SECRET_KEY=<JWT_SECRET_PLACEHOLDER>

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=14268

# AI/LLM Configuration (Optional)
OPENAI_API_KEY=<OPENAI_API_KEY_PLACEHOLDER>
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY_PLACEHOLDER>

# Security Configuration
SECRET_KEY=<SECRET_KEY_PLACEHOLDER>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (Optional)
EMAIL_USERNAME=<EMAIL_USERNAME_PLACEHOLDER>
EMAIL_PASSWORD=<EMAIL_APP_PASSWORD_PLACEHOLDER>
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Cloud Configuration (Optional)
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID_PLACEHOLDER>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY_PLACEHOLDER>
AWS_REGION=us-west-2
S3_BUCKET=<S3_BUCKET_PLACEHOLDER>

# Docker Configuration
COMPOSE_PROJECT_NAME=jaseci-learning-companion
